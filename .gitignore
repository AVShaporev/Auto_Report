# created by virtualenv automatically
.venv/

__pycache__/

.vscode/

#migration/

old/

.pytest_cache/

db/

# Plain .env-файлы — НИКОГДА в git (всё в открытом виде = утечка секретов).
# SOPS-зашифрованные `*.env.sops` коммитятся, поэтому в исключениях.
# .env.example для шаблона — тоже коммитим.
.env
*.env
!*.env.sops
!.env.example

/media/

# runtime log artifacts (rotated by loguru, weekly json dumps, archived zips)
logs/*.log
logs/*.json
logs/*.zip
logs/*.txt

# Локальные тестовые шаблоны, попадают в коммит по ошибке
templates/blanks/example_two_level.docx

