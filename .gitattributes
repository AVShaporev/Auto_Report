# Принудительный LF для shell-скриптов и Docker-файлов,
# чтобы при сборке Docker-образа на Linux не получить CRLF
# (bash в контейнере падает: `: command not found`).
*.sh           text eol=lf
Dockerfile     text eol=lf
.dockerignore  text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf

# SOPS-зашифрованные .env-файлы тоже должны быть LF — иначе при
# checkout на Windows Git конвертирует в CRLF, и `sops -d` падает
# с `parsing time ... extra text: "\x0d"`.
*.env.sops     text eol=lf
