# Auto_Report — пример переменных окружения для VDS-деплоя.
#
# Этот файл — шаблон в git'е. На VDS реальный файл лежит в /opt/auto-report/.env
# (chmod 600 root:root), НЕ в репо.
#
# Заполняется один раз вручную при первом деплое. Дальше docker compose
# читает его через env_file у каждого сервиса.

# ===== PostgreSQL =====
# Init-скрипт postgres-образа создаёт БД с этими именем/юзером/паролем
# при первом старте контейнера (когда pg_data ещё пустой).
# Меняешь после первого старта → НЕ ротирует, нужно ALTER USER через psql.
POSTGRES_DB=autoreport
POSTGRES_USER=autoreport
POSTGRES_PASSWORD=замени-на-сильный-пароль-длиной-минимум-24-символа

# ===== Backend → подключение к БД =====
# DB_HOST=postgres — это имя сервиса из docker-compose.yml,
# docker-DNS внутри ar_net резолвит его в IP postgres-контейнера.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=autoreport
DB_USER=autoreport
DB_PASSWORD=такой-же-как-POSTGRES_PASSWORD

# ===== JWT =====
# Сгенерируй: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=замени-на-случайные-64+-символа
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== Media path =====
# Внутри backend-контейнера media живёт в /app/media (volume backend_media).
# Если хочется сменить — придётся синхронизировать с volumes в docker-compose.yml.
MEDIA_ROOT=/app/media
